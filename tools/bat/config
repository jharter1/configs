# bat config (symlinked to ~/.config/bat/config)
# "ansi" uses the terminal's own colours, so it follows Ghostty's light/dark theme
--theme="ansi"
--style="default"          # changes, grid, header-filename, numbers, snip
--italic-text=always

# Repo files bat can't guess from the name
--map-syntax=".gitconfig*:Git Config"
--map-syntax="*.conf:INI"
--map-syntax="ghostty.config:INI"
--map-syntax="fish_plugins:Plain Text"
