# Theme

# Follows macOS appearance; everything else uses the ANSI slots this sets
theme = "light:TokyoNight Day,dark:TokyoNight Moon"

# Font configuration

# IBM Plex Mono (Nerd Font build, "Blex"): calm, open, no ligatures, true italics.
# Bold maps to SemiBold so emphasis doesn't shout.
font-family = "BlexMono Nerd Font Mono"
font-style-bold = SemiBold
font-style-bold-italic = SemiBold Italic
font-size = 13
adjust-cell-height = 10%

# Performance (vsync prevents tearing, non-native fullscreen is snappier)
window-vsync = true
macos-non-native-fullscreen = true

# Scrollback
scrollback-limit = 10000

# Shell integration (enables prompt jumping and better rendering)
shell-integration = fish
shell-integration-features = cursor,sudo,title

# Window appearance
window-padding-x = 10
window-padding-y = 10
window-decoration = true
background-opacity = 0.8
background-blur-radius = 20

# Cursor
cursor-style = block
cursor-style-blink = false

# Mouse and clipboard
mouse-hide-while-typing = true
copy-on-select = true
clipboard-read = allow
clipboard-write = allow

# macOS specific
macos-titlebar-style = tabs
macos-option-as-alt = true
macos-icon = xray

# Behavior
quit-after-last-window-closed = true
confirm-close-surface = false
resize-overlay = never

# Splits
window-padding-balance = true

# Contrast
minimum-contrast = 1.3
