[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[user]
	name = Jack Harter
	email = jack.harter@me.com
[pull]
	rebase = false
[core]
	pager = delta
	excludesfile = ~/.gitignore_global
[init]
	defaultBranch = main
[fetch]
	# Drop local refs to branches deleted on the remote
	prune = true
	pruneTags = true
[diff]
	algorithm = histogram
	colorMoved = default
[rerere]
	# Remember conflict resolutions and reuse them
	enabled = true
[branch]
	sort = -committerdate
[tag]
	sort = -version:refname
[rebase]
	# `git fixup <sha>` then `git rebase -i` squashes automatically
	autosquash = true
[column]
	ui = auto
[help]
	autocorrect = prompt
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	syntax-theme = ansi
	side-by-side = false
[merge]
	conflictstyle = zdiff3
[credential]
    # Platform-specific override via ~/.gitconfig.local
    helper =
[include]
    path = ~/.gitconfig.local
[url "git@github.com:"]
	insteadOf = https://github.com/
[push]
	default = current
[alias]
	fixup = commit --fixup
	recent = branch --sort=-committerdate --format='%(refname:short)' -10
	aliases = config --get-regexp alias
