// Zed settings, linked from ~/.config/zed (the whole folder, so Zed's own
// saves land here too). Matches the terminal: Tokyo Night following macOS
// light/dark, IBM Plex Mono, vim keys, quiet chrome.
// All options: `zed: open default settings` in the command palette.
{
  // Look
  "theme": {
    "mode": "system",
    "light": "Tokyo Night Light",
    "dark": "Tokyo Night Moon",
  },
  "auto_install_extensions": {
    "html": true,
    "tokyo-night": true,
  },
  "buffer_font_family": "BlexMono Nerd Font Mono",
  "buffer_font_size": 15,
  "ui_font_size": 16,
  "cursor_blink": false,

  // Editing (same habits as nvim: vim keys, relative numbers, scrolloff 8)
  "vim_mode": true,
  "base_keymap": "VSCode",
  "relative_line_numbers": "enabled",
  "vertical_scroll_margin": 8,
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },

  // Quiet chrome: fewer buttons, blame only once the cursor rests on a line
  "toolbar": {
    "quick_actions": false,
    "selections_menu": false,
  },
  "tab_bar": {
    "show_nav_history_buttons": false,
  },
  "title_bar": {
    "show_onboarding_banner": false,
  },
  "git": {
    "inline_blame": {
      "delay_ms": 600,
    },
  },

  // Terminal panel: same behaviour as Ghostty
  "terminal": {
    "blinking": "off",
    "copy_on_select": true,
    "option_as_meta": true,
  },

  // Panels: files, outline, git on the left; agent on the right
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry",
    },
  },
  "session": {
    "trust_all_worktrees": true,
  },
}
